{
  "name": "streetwear-empire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "cloud:dev": "wrangler dev --config wrangler.cloud.jsonc",
    "cloud:migrate:local": "wrangler d1 migrations apply company-tycoon-saves --local --config wrangler.cloud.jsonc",
    "cloud:migrate": "node scripts/prepare-cloud.mjs && wrangler d1 migrations apply company-tycoon-saves --remote --config .wrangler/deploy.jsonc",
    "deploy": "npm run build && node scripts/prepare-cloud.mjs && wrangler deploy --config .wrangler/deploy.jsonc"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.158.0"
  }
}
